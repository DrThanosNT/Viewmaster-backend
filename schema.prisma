generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  MANAGER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(WORKER)
  createdAt    DateTime @default(now())

  movements       Movement[]      @relation("MovedBy")
  eventAssignments EventCrew[]
  consumableUpdates ConsumableStatusLog[]
}

enum LocationType {
  STORAGE
  VEHICLE
  EVENT
  OTHER
}

model Location {
  id        String       @id @default(cuid())
  name      String
  type      LocationType
  address   String?
  latitude  Float?
  longitude Float?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  event Event? @relation(fields: [eventId], references: [id])
  eventId String? @unique

  stock          Stock[]
  movementsFrom  Movement[] @relation("FromLocation")
  movementsTo    Movement[] @relation("ToLocation")
  consumableLogs ConsumableStatusLog[]
}

enum ItemKind {
  DISCRETE
  CONSUMABLE
}

model Item {
  id          String   @id @default(cuid())
  name        String
  kind        ItemKind @default(DISCRETE)
  category    String?
  notes       String?
  photoUrl    String?
  isBroken    Boolean  @default(false)
  brokenNote  String?
  createdAt   DateTime @default(now())

  stock           Stock[]
  movements       Movement[]
  consumableLogs  ConsumableStatusLog[]
  eventAllocations EventItem[]
}

model Stock {
  id         String   @id @default(cuid())
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  location   Location @relation(fields: [locationId], references: [id])
  locationId String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([itemId, locationId])
}

enum ConsumableStatus {
  FULL
  LOW
  OUT
}

model ConsumableStatusLog {
  id         String           @id @default(cuid())
  item       Item             @relation(fields: [itemId], references: [id])
  itemId     String
  location   Location         @relation(fields: [locationId], references: [id])
  locationId String
  status     ConsumableStatus
  setBy      User?            @relation(fields: [setById], references: [id])
  setById    String?
  createdAt  DateTime         @default(now())
}

model Movement {
  id             String   @id @default(cuid())
  item           Item     @relation(fields: [itemId], references: [id])
  itemId         String
  quantity       Int      @default(1)
  fromLocation   Location? @relation("FromLocation", fields: [fromLocationId], references: [id])
  fromLocationId String?
  toLocation     Location  @relation("ToLocation", fields: [toLocationId], references: [id])
  toLocationId   String
  movedBy        User?    @relation("MovedBy", fields: [movedById], references: [id])
  movedById      String?
  note           String?
  photoUrl       String?
  createdAt      DateTime @default(now())
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Event {
  id          String      @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  address     String?
  latitude    Float?
  longitude   Float?
  status      EventStatus @default(UPCOMING)
  createdAt   DateTime    @default(now())

  location  Location?
  crew      EventCrew[]
  items     EventItem[]
  notes     EventNote[]
}

model EventCrew {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  roleOnEvent String?

  @@unique([eventId, userId])
}

enum EventItemStatus {
  RESERVED
  SHIPPED
  RETURNED
}

model EventItem {
  id         String          @id @default(cuid())
  event      Event           @relation(fields: [eventId], references: [id])
  eventId    String
  item       Item            @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Int             @default(1)
  status     EventItemStatus @default(RESERVED)
  createdAt  DateTime        @default(now())

  @@unique([eventId, itemId])
}

model EventNote {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  authorName String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}
